{
  "name": "lecture-10",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsc && tsc-alias && node -e \"const fs=require('fs');for(const f of fs.readdirSync('generated/prisma'))if(f.endsWith('.node'))fs.copyFileSync('generated/prisma/'+f,'dist/generated/prisma/'+f)\"",
    "start": "node ./dist/src/index.js",
    "db:generate": "pnpm exec prisma generate",
    "db:push": "pnpm exec prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "~6.19.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
